# PotholeGuard Dashboard Environment Configuration

# Local Development:
# VITE_API_BASE_URL=http://localhost:8000/api

# Production (e.g. Render, Railway, Fly.io):
# Set this in Vercel -> Project Settings -> Environment Variables
# IMPORTANT: Vite embeds this during build time. You must redeploy after changing it.
VITE_API_BASE_URL=https://<your-backend-app-name>.onrender.com/api
