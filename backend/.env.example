# ==============================================================================
# PotholeGuard Backend Configuration
# ==============================================================================

# Core Application Settings
APP_NAME=PotholeGuard API
APP_ENV=production
DEBUG=False
PORT=8000

# Database Connection (PostgreSQL with PostGIS or SQLite fallback)
# Render Managed Postgres example:
# DATABASE_URL=postgresql+psycopg2://username:password@dpg-xxxxx.render.com/dbname
# SQLite fallback (no external database needed for quick testing):
# DATABASE_URL=sqlite:///./potholeguard.db
DATABASE_URL=postgresql+psycopg2://potholeguard:potholeguard_secret@localhost:5432/potholeguard

# Authority Administration Key (used by dashboard to verify/fix potholes)
AUTHORITY_API_KEY=potholeguard_admin_key_2026

# Ingestion & Clustering Parameters
RATE_LIMIT_PER_MINUTE=120
CLUSTER_DISTANCE_METERS=10.0
VERIFICATION_THRESHOLD=3

# Optional: Webhook & Email Alerts
MUNICIPAL_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENT=
